-- stand track
local function getStandConstraints()
    local sm=workspace:FindFirstChild("StandMorphs"); if not sm then return nil,nil end
    local m=sm:FindFirstChild(LP.Name.."'s StandMorph"); if not m then return nil,nil end
    local hrp=m:FindFirstChild("HumanoidRootPart"); if not hrp then return nil,nil end
    local sa=hrp:FindFirstChild("StandAttach"); if not sa then return nil,nil end
    return sa:FindFirstChild("AlignPosition"),sa:FindFirstChild("AlignOrientation")
end

local function startStandTrack()
    if standTrackConn then standTrackConn:Disconnect() end
    local ap,ao=getStandConstraints()
    if not ap or not ao then return end
    origAP_Att1=ap.Attachment1; origAO_Att1=ao.Attachment1; origAO_Mode=ao.Mode
    ao.Mode=Enum.OrientationAlignmentMode.OneAttachment
    standTrackConn=RunService.Heartbeat:Connect(function()
        if not standTrackOn then return end
        local tgt=Players:FindFirstChild(standTrackTarget or "")
        if not tgt or not tgt.Character then return end
        local tHRP=tgt.Character:FindFirstChild("HumanoidRootPart"); if not tHRP then return end
        local capAP,capAO=getStandConstraints(); if not capAP or not capAO then return end
        if not tempAtt or not tempAtt.Parent then
            tempAtt=Instance.new("Attachment"); tempAtt.Name="SkidR_TrackAtt"; tempAtt.Parent=tHRP
        elseif tempAtt.Parent~=tHRP then tempAtt.Parent=tHRP end
        local zOff = standBehind and standOffset or -standOffset
        tempAtt.CFrame = CFrame.new(0, 0, zOff)
        capAP.Attachment1 = tempAtt
        if standBehind then
            local offsetPos = tHRP.CFrame * Vector3.new(0, 0, zOff)
            local tPos = tHRP.Position
            if (tPos - offsetPos).Magnitude > 0.1 then capAO.CFrame = CFrame.new(offsetPos, tPos) end
        else
            capAO.CFrame = tHRP.CFrame
        end
    end)
end

local function stopStandTrack()
    standTrackOn=false
    if standTrackConn then standTrackConn:Disconnect(); standTrackConn=nil end
    local ap,ao=getStandConstraints()
    if ap and origAP_Att1 then pcall(function() ap.Attachment1=origAP_Att1 end) end
    if ao then
        if origAO_Att1 then pcall(function() ao.Attachment1=origAO_Att1 end) end
        if origAO_Mode then pcall(function() ao.Mode=origAO_Mode end) end
    end
    if tempAtt then pcall(function() tempAtt:Destroy() end); tempAtt=nil end
    origAP_Att1,origAO_Att1,origAO_Mode=nil,nil,nil
end

-- freecam
local function startFreecam()
    if freecamConn then freecamConn:Disconnect() end
    local cam = workspace.CurrentCamera
    cam.CameraType = Enum.CameraType.Scriptable
    local c = LP.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand = true end
    if hrp then hrp.Anchored = true end
    local camPos = cam.CFrame.Position
    local look = cam.CFrame.LookVector
    local accYaw = math.atan2(-look.X, -look.Z)
    local accPitch = math.asin(math.clamp(look.Y, -1, 1))
    UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
    freecamConn = RunService.RenderStepped:Connect(function(dt)
        if not freecamOn then return end
        local delta = UIS:GetMouseDelta()
        accYaw = accYaw - delta.X * 0.003
        accPitch = math.clamp(accPitch - delta.Y * 0.003, -1.55, 1.55)
        local rot = CFrame.Angles(0, accYaw, 0) * CFrame.Angles(accPitch, 0, 0)
        local cf = CFrame.new(camPos) * rot
        local spd = freecamSpeed * dt
        if UIS:IsKeyDown(Enum.KeyCode.W) then camPos += cf.LookVector * spd end
        if UIS:IsKeyDown(Enum.KeyCode.S) then camPos -= cf.LookVector * spd end
        if UIS:IsKeyDown(Enum.KeyCode.A) then camPos -= cf.RightVector * spd end
        if UIS:IsKeyDown(Enum.KeyCode.D) then camPos += cf.RightVector * spd end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then camPos += Vector3.new(0,1,0) * spd end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then camPos -= Vector3.new(0,1,0) * spd end
        workspace.CurrentCamera.CFrame = CFrame.new(camPos) * rot
        local chr = LP.Character
        local fhrp = chr and chr:FindFirstChild("HumanoidRootPart")
        local fhum = chr and chr:FindFirstChildOfClass("Humanoid")
        if fhum then fhum.PlatformStand = true end
        if fhrp then fhrp.Anchored = true end
    end)
end
local function stopFreecam()
    freecamOn = false
    if freecamConn then freecamConn:Disconnect(); freecamConn = nil end
    workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
    UIS.MouseBehavior = Enum.MouseBehavior.Default
    local c = LP.Character
    local hrp2 = c and c:FindFirstChild("HumanoidRootPart")
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand = false end
    if hrp2 then hrp2.Anchored = false end
end

-- config persistence
local CFG_FILE = "skidr_config.json"
local function saveFilters()
    local data = {esp={}, farm={}, sell={}, buy={}}
    for k in pairs(espFilter)  do table.insert(data.esp,  k) end
    for k in pairs(farmFilter) do table.insert(data.farm, k) end
    for k in pairs(sellFilter) do table.insert(data.sell, k) end
    for k in pairs(buyFilter)  do table.insert(data.buy,  k) end
    local ok1, json = pcall(function() return game:GetService("HttpService"):JSONEncode(data) end)
    if not ok1 then return end
    pcall(function() writefile(CFG_FILE, json) end)
end

local function syncToggleUI()
    local luxtGui
    for _, v in ipairs(game:GetService("CoreGui"):GetChildren()) do
        if string.find(v.Name, "LuxtLib", 1, true) then luxtGui = v; break end
    end
    if not luxtGui then return end
    local shouldBeOn = {}
    for k in pairs(espFilter)  do shouldBeOn[k] = true end
    for k in pairs(farmFilter) do shouldBeOn[k] = true end
    for k in pairs(sellFilter) do shouldBeOn[k] = true end
    if buyFilter["Lucky Arrow_50000"]          then shouldBeOn["Lucky Arrow  [50k]"]          = true end
    if buyFilter["Lucky Requiem Arrow_100000"] then shouldBeOn["Lucky Requiem Arrow  [100k]"]  = true end
    local ON  = Color3.fromRGB(153, 255, 238)
    for _, desc in ipairs(luxtGui:GetDescendants()) do
        if desc.Name == "toggleFrame" then
            local info   = desc:FindFirstChild("toggleInfo")
            local chkBtn = desc:FindFirstChild("checkBtn")
            if info and chkBtn and shouldBeOn[info.Text] then
                info.TextColor3        = ON
                chkBtn.ImageColor3     = ON
                chkBtn.ImageRectOffset = Vector2.new(4, 836)
                chkBtn.ImageRectSize   = Vector2.new(48, 48)
            end
        end
    end
end

local function loadFilters()
    local ok1, raw = pcall(function() return readfile(CFG_FILE) end)
    if not ok1 or not raw or raw == "" then return end
    local ok2, data = pcall(function() return game:GetService("HttpService"):JSONDecode(raw) end)
    if not ok2 or not data then return end
    for t, ft in pairs({esp=espFilter, farm=farmFilter, sell=sellFilter, buy=buyFilter}) do
        for k in pairs(ft) do ft[k] = nil end
        if data[t] then for _, v in ipairs(data[t]) do ft[v] = true end end
    end
    task.spawn(syncToggleUI)
end

