local function getMoneyValue()
    local pg = LP:FindFirstChild("PlayerGui")
    local hud = pg and pg:FindFirstChild("HUD")
    local main = hud and hud:FindFirstChild("Main")
    local dm = main and main:FindFirstChild("DropMoney")
    local ml = dm and dm:FindFirstChild("Money")
    if not ml then return 0 end
    local s = ml.Text:gsub(",",""):gsub("%s","")
    return tonumber(s) or 0
end

local function getBuyRemote()
    local alive = workspace:FindFirstChild("Alive")
    local me    = alive and alive:FindFirstChild(LP.Name)
    return me and me:FindFirstChild("RemoteFunction")
end

local BUY_CAP = {
    ["Lucky Arrow"]         = 25,
    ["Lucky Requiem Arrow"] = 10,
}
local BUY_TOGGLE_LABEL = {
    ["Lucky Arrow"]         = "Lucky Arrow  [50k]",
    ["Lucky Requiem Arrow"] = "Lucky Requiem Arrow  [100k]",
}

local function countInInventory(itemName)
    local count = 0
    for _, t in ipairs(LP.Backpack:GetChildren()) do
        if t:IsA("Tool") and t.Name == itemName then count += 1 end
    end
    local c = LP.Character
    if c then
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") and t.Name == itemName then count += 1 end
        end
    end
    return count
end

local function disableBuyItem(name, price)
    local key = name.."_"..price
    buyFilter[key] = nil
    task.spawn(function()
        local lg
        for _, v in ipairs(game:GetService("CoreGui"):GetChildren()) do
            if string.find(v.Name, "LuxtLib", 1, true) then lg = v; break end
        end
        if not lg then return end
        local label = BUY_TOGGLE_LABEL[name]
        if not label then return end
        for _, d in ipairs(lg:GetDescendants()) do
            if d.Name == "toggleFrame" then
                local inf = d:FindFirstChild("toggleInfo")
                local btn = d:FindFirstChild("checkBtn")
                if inf and btn and inf.Text == label then
                    setToggle(btn, false)
                    break
                end
            end
        end
    end)
    print(string.format("[autobuy] cap reached for %s — disabled", name))
end

local function autoBuyLoop()
    while autoBuyOn do
        if next(buyFilter) ~= nil then
            local money = getMoneyValue()
            local rf    = getBuyRemote()
            if rf then
                local bought = false
                for _, entry in ipairs(BUY_CATALOG) do
                    local name, price = entry[1], entry[2]
                    local key = name.."_"..price
                    if buyFilter[key] then
                        local cap = BUY_CAP[name]
                        if cap and countInInventory(name) >= cap then
                            disableBuyItem(name, price)
                        elseif money >= price then
                            print(string.format("[autobuy] buying %s for %d (money=%d)", name, price, money))
                            pcall(function() rf:InvokeServer("BuyItem", name, price) end)
                            bought = true
                            task.wait(1)
                            money = getMoneyValue()
                        end
                    end
                end
                if not bought then task.wait(0.5) end
            else
                task.wait(0.5)
            end
        else
            task.wait(0.5)
        end
    end
end

local function startAutoBuy()
    autoBuyOn = true
    if autoBuyThread then task.cancel(autoBuyThread) end
    autoBuyThread = task.spawn(autoBuyLoop)
end

local function stopAutoBuy()
    autoBuyOn = false
    if autoBuyThread then task.cancel(autoBuyThread); autoBuyThread = nil end
end
