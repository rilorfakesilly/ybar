-- folder
local function getFolder()
    local s = workspace:FindFirstChild("Item_Spawns")
    return s and s:FindFirstChild("Items")
end

local function getPos(item)
    if item:IsA("Model") then
        if item.PrimaryPart then return item.PrimaryPart.Position end
        for _,d in ipairs(item:GetDescendants()) do
            if d:IsA("BasePart") then return d.Position end
        end
    elseif item:IsA("BasePart") then return item.Position end
end

local function getDist(pos)
    local c = LP.Character
    if c and c.HumanoidRootPart then
        return math.floor((c.HumanoidRootPart.Position-pos).Magnitude)
    end
    return 0
end

-- ESP: persistent label per item, no pool recycling confusion
local function mkDrawing(sz,col)
    local t = Drawing.new("Text")
    t.Size=sz; t.Font=0; t.Color=col
    t.Outline=true; t.OutlineColor=Color3.fromRGB(15,10,30)
    t.Center=true; t.Visible=false
    return t
end

local function startESP()
    if espConn then espConn:Disconnect() end
    espConn = RunService.RenderStepped:Connect(function()
        local cam = workspace.CurrentCamera
        if not cam then return end
        local f = getFolder()

        -- hide all first
        for _,lbls in pairs(espLabels) do
            lbls.name.Visible=false
        end

        if not espOn or not f then return end

        -- clean stale
        for item in pairs(espLabels) do
            if not item.Parent then
                espLabels[item].name:Remove()
                espLabels[item]=nil
            end
        end

        for _,item in ipairs(f:GetChildren()) do
            local pos = getPos(item)
            if not pos then continue end
            if next(espFilter)~=nil and not espFilter[item.Name] then continue end
            local sv = cam:WorldToViewportPoint(pos)
            if sv.Z <= 0 then continue end

            -- create label if new item
            if not espLabels[item] then
                espLabels[item] = {
                    name = mkDrawing(15, Color3.fromRGB(210,195,255))
                }
            end

            local lbls = espLabels[item]
            local s2 = Vector2.new(sv.X, sv.Y)
            lbls.name.Text=item.Name; lbls.name.Position=s2; lbls.name.Visible=true
        end
    end)
end

-- fly animation tracks
local flyTrackIdle, flyTrackMove = nil, nil
local ANIM_IDLE = "rbxassetid://111366024393484"
local ANIM_MOVE = "rbxassetid://86655743171657"

local function loadFlyAnims(hum)
    local anim = hum:FindFirstChildOfClass("Animator")
    if not anim then return end
    local ai = Instance.new("Animation"); ai.AnimationId = ANIM_IDLE
    local am = Instance.new("Animation"); am.AnimationId = ANIM_MOVE
    flyTrackIdle = anim:LoadAnimation(ai); flyTrackIdle.Looped = true; flyTrackIdle.Priority = Enum.AnimationPriority.Action4
    flyTrackMove = anim:LoadAnimation(am); flyTrackMove.Looped = true; flyTrackMove.Priority = Enum.AnimationPriority.Action4
    flyTrackIdle:Play(0.3)
end

local function stopFlyAnims()
    if flyTrackIdle then pcall(function() flyTrackIdle:Stop(0.3) end); flyTrackIdle = nil end
    if flyTrackMove then pcall(function() flyTrackMove:Stop(0.3) end); flyTrackMove = nil end
end

local function startFly()
    if flyConn then flyConn:Disconnect() end
    local c = LP.Character; if not c then return end
    local hum = c:FindFirstChildOfClass("Humanoid"); if not hum then return end
    local hrp = c:FindFirstChild("HumanoidRootPart"); if not hrp then return end

    loadFlyAnims(hum)
    hum.PlatformStand = true
    hrp.Anchored      = false

    -- Physics-based fly (BodyVelocity + BodyGyro) replicates to others
    local bv = hrp:FindFirstChild("SkidRFlyBV") or Instance.new("BodyVelocity")
    bv.Name = "SkidRFlyBV"
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.Parent = hrp

    local bg = hrp:FindFirstChild("SkidRFlyBG") or Instance.new("BodyGyro")
    bg.Name = "SkidRFlyBG"
    bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.P = 9e4
    bg.CFrame = hrp.CFrame
    bg.Parent = hrp

    local wasMoving = false
    flyConn = RunService.RenderStepped:Connect(function(dt)
        if not flyOn then return end
        c   = LP.Character; if not c then return end
        hrp = c:FindFirstChild("HumanoidRootPart")
        hum = c:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end

        hum.PlatformStand = true
        hrp.Anchored      = false

        local cf    = workspace.CurrentCamera.CFrame
        local dir   = Vector3.new()
        local moving = false

        if UIS:IsKeyDown(Enum.KeyCode.W)            then dir += cf.LookVector;         moving = true end
        if UIS:IsKeyDown(Enum.KeyCode.S)            then dir -= cf.LookVector;         moving = true end
        if UIS:IsKeyDown(Enum.KeyCode.A)            then dir -= cf.RightVector;        moving = true end
        if UIS:IsKeyDown(Enum.KeyCode.D)            then dir += cf.RightVector;        moving = true end
        if UIS:IsKeyDown(Enum.KeyCode.Space)        then dir += Vector3.new(0,1,0);    moving = true end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl)  then dir -= Vector3.new(0,1,0);    moving = true end

        local activeBv = hrp:FindFirstChild("SkidRFlyBV")
        local activeBg = hrp:FindFirstChild("SkidRFlyBG")
        
        if activeBv then
            if moving then
                activeBv.Velocity = dir.Unit * flySpeed
            else
                activeBv.Velocity = Vector3.new(0, 0, 0)
            end
        end
        if activeBg then
            activeBg.CFrame = cf
        end

        if moving ~= wasMoving then
            wasMoving = moving
            if flyTrackIdle and flyTrackMove then
                if moving then
                    flyTrackIdle:Stop(0.15); flyTrackMove:Play(0.15)
                else
                    flyTrackMove:Stop(0.15); flyTrackIdle:Play(0.15)
                end
            end
        end
    end)
end

local function stopFly()
    flyOn = false
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    stopFlyAnims()
    local c   = LP.Character; if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if hrp then 
        hrp.Anchored = false 
        local bv = hrp:FindFirstChild("SkidRFlyBV")
        if bv then bv:Destroy() end
        local bg = hrp:FindFirstChild("SkidRFlyBG")
        if bg then bg:Destroy() end
        hrp.Velocity = Vector3.new(0,0,0)
        hrp.RotVelocity = Vector3.new(0,0,0)
    end
    if hum then hum.PlatformStand = false end
end


