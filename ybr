-- auto sell
local VIM = game:GetService("VirtualInputManager")

local function getMerchant()
    local d = workspace:FindFirstChild("Dialogues")
    if not d then return nil end
    for _, v in ipairs(d:GetChildren()) do
        if v.Name:lower():find("merchant") or v.Name:lower():find("plox") then
            return v
        end
    end
    return nil
end

local function waitForBtn(optName, timeout)
    local t = 0
    while t < timeout do
        local dlg = LP.PlayerGui:FindFirstChild("Dialogue")
        local iact = dlg and dlg:FindFirstChild("Interact")
        if iact and iact.Visible then
            local opt = iact:FindFirstChild(optName)
            if opt then
                local btn = opt
                if not opt:IsA("TextButton") and not opt:IsA("ImageButton") then
                    btn = opt:FindFirstChild("TextButton") or opt:FindFirstChildWhichIsA("TextButton", true)
                end
                if btn and btn.Visible and btn.Text ~= "" then
                    task.wait(0.2)
                    return iact, btn
                end
            end
        end
        task.wait(0.2); t = t + 0.2
    end
    return nil, nil
end

local function vimClick(btn)
    if not btn then return end
    local inset = game:GetService("GuiService"):GetGuiInset()
    local x = btn.AbsolutePosition.X + btn.AbsoluteSize.X * 0.5 + inset.X
    local y = btn.AbsolutePosition.Y + btn.AbsoluteSize.Y * 0.5 + inset.Y
    VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
    task.wait(0.08)
    VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
end

local function getOptText(iact, optName)
    local opt = iact:FindFirstChild(optName)
    if not opt then return "" end
    if opt:IsA("TextButton") then return opt.Text end
    local tb = opt:FindFirstChild("TextButton") or opt:FindFirstChildWhichIsA("TextButton", true)
    return tb and tb.Text or ""
end

local function doSellItem(itemName)
    local m = getMerchant()
    local cd = m and m:FindFirstChildWhichIsA("ClickDetector", true)
    if not cd then print("[sell] no Merchant found"); return end
    print("[sell] -> " .. itemName)
    
    pcall(fireclickdetector, cd, 0)
    task.wait(0.2)
    pcall(fireclickdetector, cd, 10)
    
    local iact, _ = waitForBtn("Option1", 8)
    if not iact then print("[sell] dialog timed out - UI not detected"); return end
    local tool = LP.Backpack:FindFirstChild(itemName)
    if tool then
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        pcall(function()
            if hum then hum:EquipTool(tool) else tool.Parent = LP.Character end
        end)
        task.wait(0.5)
    end
    local function clickUntilTextChange(optName, maxTries)
        for i = 1, maxTries do
            local prevText = getOptText(iact, optName)
            local _, btn = waitForBtn(optName, 2)
            if not btn then return false end
            vimClick(btn)
            for _ = 1, 10 do
                task.wait(0.1)
                local cur = getOptText(iact, optName)
                if cur ~= "" and cur ~= prevText then return true end
            end
        end
        return false
    end
    local function clickUntilOpt2All(maxTries)
        for i = 1, maxTries do
            local opt2Text = getOptText(iact, "Option2")
            if opt2Text:lower():find("all") then return true end
            local _, btn = waitForBtn("Option1", 2)
            if not btn then return false end
            vimClick(btn)
            for _ = 1, 20 do
                task.wait(0.1)
                opt2Text = getOptText(iact, "Option2")
                if opt2Text:lower():find("all") then return true end
            end
        end
        return false
    end
    clickUntilTextChange("Option1", 5)
    clickUntilOpt2All(5)
    task.wait(0.3)
    local _, btn3 = waitForBtn("Option2", 5)
    if btn3 and btn3.Text:lower():find("all") then vimClick(btn3) end
    task.wait(2)
end

local function sellLoop()
    while sellOn do
        local seen, toSell = {}, {}
        for _, tool in ipairs(LP.Backpack:GetChildren()) do
            if tool:IsA("Tool") and not seen[tool.Name] then
                if next(sellFilter) == nil or sellFilter[tool.Name] then
                    seen[tool.Name] = true
                    table.insert(toSell, tool.Name)
                end
            end
        end
        for _, name in ipairs(toSell) do
            if not sellOn then break end
            doSellItem(name)
            task.wait(1.5 + math.random())
        end
        task.wait(2 + math.random())
    end
end

local function startSell()
    sellOn = true
    if sellThread then task.cancel(sellThread) end
    sellThread = task.spawn(sellLoop)
end

local function stopSell() sellOn = false end

